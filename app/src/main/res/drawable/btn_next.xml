<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#AA6A0DAD"/> <!-- Morado Spyro más intenso -->
            <corners android:radius="25dp"/>
            <stroke android:width="2dp" android:color="#FFD700"/> <!-- Borde dorado -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#886A0DAD"/> <!-- Morado Spyro translúcido -->
            <corners android:radius="25dp"/>
            <stroke android:width="2dp" android:color="#FFD700"/>
        </shape>
    </item>
</selector>
